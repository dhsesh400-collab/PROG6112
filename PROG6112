import java.util.HashMap;

public class Ward {

    private final String[][] beds;
    private final HashMap<String, String> allocations;

    public Ward() {

        beds = new String[4][5];
        allocations = new HashMap<>();

        int num = 1;

        for (int r = 0; r < 4; r++) {
            for (int c = 0; c < 5; c++) {
                beds[r][c] = String.format("B%02d", num++);
            }
        }
    }

    public void displayWard() {

        for (String[] row : beds) {
            for (String bed : row) {

                if (allocations.containsKey(bed)) {
                    System.out.print("[X] ");
                } else {
                    System.out.print(bed + " ");
                }
            }
            System.out.println();
        }
    }

    public boolean allocateBed(String patientId, String bedNumber) {

        if (allocations.containsKey(bedNumber)) {
            return false;
        }

        allocations.put(bedNumber, patientId);
        return true;
    }

    public boolean releaseBed(String bedNumber) {

        if (allocations.containsKey(bedNumber)) {
            allocations.remove(bedNumber);
            return true;
        }

        return false;
    }

    public void displayAvailableBeds() {

        for (String[] row : beds) {
            for (String bed : row) {
                if (!allocations.containsKey(bed)) {
                    System.out.println(bed);
                }
            }
        }
    }

    public void displayOccupiedBeds() {

        allocations.forEach((bed, patient) ->
                System.out.println(bed + " -> " + patient));
    }
}

import java.util.ArrayList;
import java.util.Comparator;

public class HospitalSystem {

    private ArrayList<Patient> patients;
    private Ward ward;

    public HospitalSystem() {
        patients = new ArrayList<>();
        ward = new Ward();
    }

    public boolean addPatient(Patient patient) {

        for (Patient p : patients) {
            if (p.getPatientId().equals(patient.getPatientId())) {
                return false;
            }
        }

        patients.add(patient);
        return true;
    }

    public Patient searchPatient(String id) {

        for (Patient p : patients) {
            if (p.getPatientId().equals(id)) {
                return p;
            }
        }

        return null;
    }

    public boolean deletePatient(String id) {

        Patient p = searchPatient(id);

        if (p != null) {
            patients.remove(p);
            return true;
        }

        return false;
    }

    public void displayPatients() {

        for (Patient p : patients) {
            p.displayInfo();
            System.out.println("----------------");
        }
    }

    public void sortBySurname() {

        patients.sort(
            Comparator.comparing(Patient::getLastName)
        );
    }

    public void sortByPatientId() {

        patients.sort(
            Comparator.comparing(Patient::getPatientId)
        );
    }

    public Ward getWard() {
        return ward;
    }
}
